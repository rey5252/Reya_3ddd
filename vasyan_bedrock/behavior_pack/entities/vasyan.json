{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "vasyan:vasyan",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "vasyan:wild": {
        "minecraft:tameable": {
          "probability": 1.0,
          "tame_items": "minecraft:redstone",
          "tame_event": { "event": "vasyan:on_tame", "target": "self" }
        },
        "minecraft:behavior.random_stroll": { "priority": 6, "speed_multiplier": 0.8 }
      },
      "vasyan:tamed": {
        "minecraft:is_tamed": {},
        "minecraft:behavior.follow_owner": {
          "priority": 3,
          "speed_multiplier": 1.15,
          "start_distance": 6,
          "stop_distance": 2,
          "can_teleport": true
        },
        "minecraft:behavior.random_stroll": { "priority": 8, "speed_multiplier": 0.7 }
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["vasyan", "mob"] },
      "minecraft:health": { "value": 40, "max": 40 },
      "minecraft:collision_box": { "width": 0.6, "height": 1.9 },
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:movement": { "value": 0.3 },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "can_open_doors": true,
        "can_pass_doors": true,
        "avoid_water": true,
        "avoid_damage_blocks": true
      },
      "minecraft:annotation.open_door": {},
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0 },
      "minecraft:nameable": { "always_show": true, "allow_name_tag_renaming": true },
      "minecraft:persistent": {},
      "minecraft:inventory": { "container_type": "inventory", "inventory_size": 9, "private": false },
      "minecraft:loot": { "table": "loot_tables/entities/vasyan.json" },
      "minecraft:damage_sensor": {
        "triggers": [
          { "cause": "fall", "deals_damage": "no" },
          { "cause": "suffocation", "deals_damage": "no" }
        ]
      },
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "filters": {
                "all_of": [
                  { "test": "is_family", "subject": "other", "value": "player" },
                  { "test": "has_equipment", "subject": "other", "domain": "hand", "operator": "not", "value": "minecraft:redstone" }
                ]
              },
              "event": "vasyan:interacted",
              "target": "self"
            },
            "interact_text": "action.interact.vasyan"
          }
        ]
      },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.look_at_player": { "priority": 7, "look_distance": 8, "probability": 0.05 },
      "minecraft:behavior.random_look_around": { "priority": 9 }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": ["vasyan:wild"] }
      },
      "vasyan:on_tame": {
        "remove": { "component_groups": ["vasyan:wild"] },
        "add": { "component_groups": ["vasyan:tamed"] }
      },
      "vasyan:interacted": {}
    }
  }
}
