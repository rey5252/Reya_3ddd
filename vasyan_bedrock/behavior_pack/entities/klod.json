            "deals_damage": "no"
          },
          {
            "cause": "fire",
            "deals_damage": "no"
          }
        ]
      },
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "has_equipment",
                    "subject": "other",
                    "domain": "hand",
                    "operator": "not",
                    "value": "minecraft:redstone"
                  }
                ]
              },
              "event": "vasyan:interacted",
              "target": "self"
            },
            "interact_text": "action.interact.vasyan"
          }
        ]
      },
