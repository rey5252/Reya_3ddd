        "add": {
          "component_groups": [
            "vasyan:staying"
          ]
        }
      },
      "vasyan:follow": {
        "remove": {
          "component_groups": [
            "vasyan:staying"
          ]
        },
        "add": {
          "component_groups": [
            "vasyan:tamed"
          ]
        }
