<?xml version="1.0" encoding="utf-8"?>
<!--
    FortressTowers 1.0 - root AssetDeclaration of the mod.
    References the base game (static / global / audio) and pulls in every mod data file.
    Paths are relative to this file (data/).
-->
<AssetDeclaration xmlns="uri:ea.com:eala:asset" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <Includes>
        <!-- Base game -->
        <Include type="reference" source="DATA:static.xml" />
        <Include type="reference" source="DATA:global.xml" />
        <Include type="reference" source="DATA:audio.xml" />

        <!-- Art: custom W3X tower models in art/FT (exported with scripts/build_models.py and Blender) -->
        <Include type="all" source="Art/FortressModels.xml" />

        <!-- Towers: Allies -->
        <Include type="all" source="Towers/Allied/AlliedPrismSpire.xml" />
        <Include type="all" source="Towers/Allied/AlliedCryoBastion.xml" />
        <Include type="all" source="Towers/Allied/AlliedAegisSpire.xml" />

        <!-- Towers: Soviets -->
        <Include type="all" source="Towers/Soviet/SovietTeslaObelisk.xml" />
        <Include type="all" source="Towers/Soviet/SovietFlakNest.xml" />
        <Include type="all" source="Towers/Soviet/SovietInfernoBunker.xml" />
        <Include type="all" source="Towers/Soviet/SovietTsarCannon.xml" />

        <!-- Towers: Empire of the Rising Sun -->
        <Include type="all" source="Towers/Japan/JapanTenguSpire.xml" />
        <Include type="all" source="Towers/Japan/JapanWaveCitadel.xml" />
        <Include type="all" source="Towers/Japan/JapanKitsuneShrine.xml" />

        <!-- Integration: upgrades, commands, command sets (vanilla overrides last) -->
        <Include type="all" source="Logic/FortressUpgrades.xml" />
        <Include type="all" source="Logic/FortressCommands.xml" />
        <Include type="all" source="Logic/FortressCommandSets.xml" />
    </Includes>
</AssetDeclaration>
